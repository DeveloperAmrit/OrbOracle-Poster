# Dynamic coin configuration
COINGECKO_COIN_ID=ethereum-classic

# Node Provider JSON-RPC endpoint (e.g., Alchemy, Infura, local node)
RPC_URL=https://etc.rivet.link/ 

# Wallet submitting the tx
PRIVATE_KEY=your_private_key_here

# Address of deployed Orb Oracle
ORACLE_ADDRESS=your_deployed_oracle_address_here

# Rest API for fetching price (e.g. CoinGecko, Binance, Pyth off-chain API)
FEED_URL=https://api.coingecko.com/api/v3/simple/price?ids=${COINGECKO_COIN_ID}&vs_currencies=usd

# Chainlink Aggregator Contract Address (Optional, if set it will fetch from Chainlink)
CHAINLINK_FEED_ADDRESS=
# RPC Url to use for Chainlink feed (Optional, defaults to RPC_URL)
CHAINLINK_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Pyth Price Feed ID (Defaults to ADA/USD)
PYTH_PRICE_ID=0x3fa4252848f9f0a1480be62745a4629d9eb1322aebab8a791e344b3b9c1adcf5

# Frequency of submissions in milliseconds
UPDATE_INTERVAL_MS=60000

# Minimum token amount required to submit 
MIN_STAKE_REQUIRED=10
